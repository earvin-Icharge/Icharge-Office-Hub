{
  "appId": "ph.com.icharge.officehub",
  "appName": "Office Hub",
  "webDir": "www",
  "appendUserAgent": "OfficeHubApp/4",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#16210F",
      "showSpinner": false,
      "androidScaleType": "CENTER_INSIDE"
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DARK"
    }
  }
}
