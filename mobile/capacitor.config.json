{
  "appId": "ph.com.icharge.officehub",
  "appName": "Office Hub",
  "webDir": "www",
  "appendUserAgent": "OfficeHubApp/2",
  "server": {
    "url": "https://icharge-office-hub.vercel.app/today",
    "androidScheme": "https",
    "allowNavigation": ["icharge-office-hub.vercel.app"],
    "errorPath": "offline.html"
  },
  "android": {
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#16210F",
      "showSpinner": false,
      "androidScaleType": "CENTER_INSIDE"
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DARK"
    }
  }
}
