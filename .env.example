# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# The app's public address (used by the test-login script)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret the database sends when it calls /api/cron/* (server only)
CRON_SECRET=
# Phone/computer notifications in browsers (web push)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# App emails through Resend (server only); EMAIL_FROM once icharge.com.ph is verified
RESEND_API_KEY=
EMAIL_FROM=
# Android app alerts: Firebase service account JSON, one line (server only)
FIREBASE_SERVICE_ACCOUNT=
